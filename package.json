{
  "name": "typescript-studies",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript studies, practice, problems, algorithms, data structures, and small projects.",
  "workspaces": [
    "projects/*"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "tsc -p tsconfig.node.json --noEmit && npm run check --workspaces --if-present",
    "clean": "rm -rf coverage dist *.tsbuildinfo && npm run clean --workspaces --if-present",
    "example": "tsx",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "fetch-leetcode": "tsx scripts/fetch-leetcode-question.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "new-algorithm": "tsx scripts/new-algorithm.ts",
    "new-custom-problem": "tsx scripts/new-custom-problem.ts",
    "new-data-structure": "tsx scripts/new-data-structure.ts",
    "new-leetcode": "tsx scripts/new-problem.ts",
    "new-problem": "tsx scripts/new-problem.ts",
    "new-theory": "tsx scripts/new-theory.ts",
    "test": "tsx --test \"{algorithms,data-structures,problems}/**/*.test.ts\" && npm run test --workspaces --if-present",
    "test:watch": "tsx --test --watch \"{algorithms,data-structures,problems}/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
